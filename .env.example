# Copy to .env and edit. All settings are documented in emqc/config.py.

# Local MySQL (official DMG install, mysqld on 3306). Create the database + user with scripts/init_mysql.sql first.
EMQC_DB_URL=mysql+pymysql://em_qc:你的密码@127.0.0.1:3306/em_qc?charset=utf8mb4
# Alternative: use root directly (not recommended)
# EMQC_DB_URL=mysql+pymysql://root:YOUR_ROOT_PASSWORD@127.0.0.1:3306/em_qc?charset=utf8mb4

# Root that contains project_terminal/<project>/datasets/datasets/<dataset_id>/
# In production point this at the Tailscale mounted directory, e.g. /Volumes/tailscale or /Users/mac/mnt/<工作站>
EMQC_DATA_ROOT=./data_root
EMQC_DATASET_GLOB=project_terminal/*/datasets/datasets/*

EMQC_BLOCK_SIZE_Z=100
EMQC_BLOCK_SIZE_XY=1024
EMQC_LARGE_DATASET_VOXELS=2000000000
# large datasets: training sample of blocks, stratified by grade (user decision 2026-09-12)
EMQC_TRAIN_SAMPLE_POLICY=stratified
EMQC_TRAIN_SAMPLE_BLOCKS=8
EMQC_TRAIN_SAMPLE_STRATA=A:0.5,B:0.3,C:0.2
EMQC_TRAIN_SAMPLE_SEED=42
EMQC_PREVIEW_DIR=./var/previews
EMQC_API_PORT=8765

# remote data sources read over SSH on demand (semicolon separated); override manifests go to var/manifests/<dir>.json
EMQC_REMOTE_ROOTS=sftp://<用户>@<服务器地址><数据根目录>
